{
    "name": "Xilinx Boundingbox L2 Test",
    "description": [
        "Boundingbox L2 function example"
    ],
    "flow": "system",
    "platform_allowlist": [
        "vck190"
    ],
    "platform_blocklist": [],
    "platform_properties": {
        "vck190": {
            "host": {
                "compiler": {
                    "includepaths": [
                        "$(SYSROOT)/usr/include",
                        "$(SYSROOT)/usr/include/opencv4"
                    ]
                },
                "linker": {
                    "librarypaths": [
                        "$(SYSROOT)/usr/lib",
                        "${SYSROOT}/lib"
                    ]
                }
            }
        }
    },
    "gui": true,
    "launch": [
        {
            "target": "hw_emu",
            "cmd_args": "LIB_DIR/data/4k.jpg 3",
            "name": "hw_emu",
            "ld_library_path": [
                "$(OPENCV_LIB)",
                "$(LD_LIBRARY_PATH)",
                "$(XILINX_XRT)/lib"
            ]
        },
        {
            "target": "hw",
            "cmd_args": "LIB_DIR/data/4k.jpg 3",
            "name": "hardware_build",
            "ld_library_path": [
                "$(OPENCV_LIB)",
                "$(LD_LIBRARY_PATH)",
                "$(XILINX_XRT)/lib"
            ]
        }
    ],
    "data": [
        "LIB_DIR/data/4k.jpg"
    ],
    "host": {
        "host_exe": "boundingbox",
        "compiler": {
            "sources": [
                "LIB_DIR/L2/examples/boundingbox/xf_boundingbox_tb.cpp",
                "LIB_DIR/ext/xcl2/xcl2.cpp"
            ],
            "includepaths": [
                "LIB_DIR/L2/examples/boundingbox/config"
            ],
            "options": "-O3 -I$(XILINX_HLS)/include -I$(XILINX_HLS)/include -I$(XILINX_HLS)/include",
            "symbols": [
                "__SDSVHLS__",
                "__SDA_MEM_MAP__"
            ]
        }
    },
    "v++": {
        "compiler": {
            "symbols": [
                "__SDA_MEM_MAP__"
            ],
            "includepaths": [
                "LIB_DIR/L2/examples/boundingbox/config"
            ],
            "clflags": []
        }
    },
    "containers": [
        {
            "name": "krnl_boundingbox",
            "accelerators": [
                {
                    "name": "boundingbox_accel",
                    "location": "LIB_DIR/L2/examples/boundingbox/xf_boundingbox_accel.cpp",
                    "frequency": 300.0
                }
            ],
            "frequency": 300.0
        }
    ],
    "testinfo": {
        "disable": false,
        "lsf_dynamic": "memory",
        "jobs": [
            {
                "index": 0,
                "dependency": [],
                "env": "",
                "cmd": "",
                "max_memory_MB": {
                    "vitis_hw_build": 16384,
                    "vitis_hw_emu": 8192,
                    "vitis_hw_run": 4096
                },
                "max_time_min": {
                    "vitis_hw_build": 470,
                    "vitis_hw_emu": 470,
                    "vitis_hw_run": 50
                }
            }
        ],
        "targets": [
            "vitis_hw_emu",
            "vitis_hw_build",
            "vitis_hw_run"
        ],
        "category": "full"
    }
}