{
    "name": "xilinx Canny_NPPC1_8UC1_8UC1 l2 test",
    "description": [
        "Canny L2 function example"
    ],
    "flow": "system",
    "platform_allowlist": [
        "vck190"
    ],
    "platform_blocklist": [],
    "platform_properties": {
        "vck190": {
            "host": {
                "compiler": {
                    "includepaths": [
                        "$(SYSROOT)/usr/include",
                        "$(SYSROOT)/usr/include/opencv4"
                    ]
                },
                "linker": {
                    "librarypaths": [
                        "$(SYSROOT)/usr/lib",
                        "${SYSROOT}/lib"
                    ]
                }
            }
        }
    },
    "gui": true,
    "launch": [
        {
            "target": "hw_emu",
            "cmd_args": " LIB_DIR/data/128x128_24.jpg",
            "name": "hw_emu",
            "ld_library_path": [
                "$(OPENCV_LIB)",
                "$(LD_LIBRARY_PATH)",
                "$(XILINX_XRT)/lib"
            ]
        },
        {
            "target": "hw",
            "cmd_args": " LIB_DIR/data/512x512.jpg",
            "name": "hardware_build",
            "ld_library_path": [
                "$(OPENCV_LIB)",
                "$(LD_LIBRARY_PATH)",
                "$(XILINX_XRT)/lib"
            ]
        }
    ],
    "data": [
        "LIB_DIR/data/512x512.jpg",
        "LIB_DIR/data/128x128_24.jpg"
    ],
    "host": {
        "host_exe": "canny",
        "compiler": {
            "sources": [
                "LIB_DIR/L2/examples/canny/xf_canny_tb.cpp",
                "LIB_DIR/ext/xcl2/xcl2.cpp"
            ],
            "includepaths": [
                "LIB_DIR/L2/tests/canny/canny_NPPC1_8UC1_8UC1"
            ],
            "options": "-O3 -I$(XILINX_HLS)/include -I$(XILINX_HLS)/include -I$(XILINX_HLS)/include"
        }
    },
    "v++": {
        "compiler": {
            "symbols": [],
            "includepaths": [
                "LIB_DIR/L2/tests/canny/canny_NPPC1_8UC1_8UC1"
            ],
            "clflags": []
        }
    },
    "containers": [
        {
            "name": "krnl_canny",
            "accelerators": [
                {
                    "name": "canny_accel",
                    "location": "LIB_DIR/L2/examples/canny/xf_canny_accel.cpp",
                    "frequency": 300.0
                },
                {
                    "name": "edgetracing_accel",
                    "clflags": "-D__SDA_MEM_MAP__",
                    "location": "LIB_DIR/L2/examples/canny/xf_edgetracing_accel.cpp",
                    "frequency": 300.0
                }
            ],
            "frequency": 300.0
        }
    ],
    "testinfo": {
        "disable": false,
        "stacksize": 16384,
        "lsf_dynamic": "memory",
        "jobs": [
            {
                "index": 0,
                "dependency": [],
                "env": "",
                "cmd": "",
                "max_memory_MB": {
                    "vitis_hw_build": 16384,
                    "vitis_hw_emu": 8192,
                    "vitis_hw_run": 4096
                },
                "max_time_min": {
                    "vitis_hw_build": 470,
                    "vitis_hw_emu": 720,
                    "vitis_hw_run": 50
                }
            }
        ],
        "targets": [
            "vitis_hw_emu",
            "vitis_hw_build",
            "vitis_hw_run"
        ],
        "category": "full"
    }
}
