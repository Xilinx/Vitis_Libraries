{
    "name": "xilinx Degamma_NPPC1_16UC1_16UC1_BAYER_GR l2 test",
    "description": [
        "Degamma L2 function example"
    ],
    "flow": "system",
    "platform_allowlist": [
        "vck190"
    ],
    "platform_blocklist": [],
    "platform_properties": {
        "vck190": {
            "host": {
                "compiler": {
                    "includepaths": [
                        "$(SYSROOT)/usr/include",
                        "$(SYSROOT)/usr/include/opencv4"
                    ]
                },
                "linker": {
                    "librarypaths": [
                        "$(SYSROOT)/usr/lib",
                        "${SYSROOT}/lib"
                    ]
                }
            },
            "containers": [
                {
                    "name": "krnl_degamma",
                    "accelerators": [
                        {
                            "name": "degamma_accel",
                            "frequency": 200.0
                        }
                    ],
                    "frequency": 200.0
                }
            ]
        }
    },
    "gui": true,
    "launch": [
        {
            "target": "hw_emu",
            "cmd_args": " LIB_DIR/data/ltm_input_s.png",
            "name": "hw_emu",
            "ld_library_path": [
                "$(OPENCV_LIB)",
                "$(LD_LIBRARY_PATH)",
                "$(XILINX_XRT)/lib"
            ]
        },
        {
            "target": "hw",
            "cmd_args": " LIB_DIR/data/ltm_input_HD.png",
            "name": "hardware_build",
            "ld_library_path": [
                "$(OPENCV_LIB)",
                "$(LD_LIBRARY_PATH)",
                "$(XILINX_XRT)/lib"
            ]
        }
    ],
    "data": [
        "LIB_DIR/data/ltm_input_s.png",
        "LIB_DIR/data/ltm_input_HD.png"
    ],
    "host": {
        "host_exe": "degamma",
        "compiler": {
            "sources": [
                "LIB_DIR/L2/examples/degamma/xf_degamma_tb.cpp",
                "LIB_DIR/ext/xcl2/xcl2.cpp"
            ],
            "includepaths": [
                "LIB_DIR/L2/tests/degamma/degamma_NPPC1_16UC1_16UC1_BAYER_GR"
            ],
            "options": "-O3 -I$(XILINX_HLS)/include -I$(XILINX_HLS)/include -I$(XILINX_HLS)/include",
            "symbols": []
        }
    },
    "v++": {
        "compiler": {
            "symbols": [],
            "includepaths": [
                "LIB_DIR/L2/tests/degamma/degamma_NPPC1_16UC1_16UC1_BAYER_GR"
            ],
            "clflags": []
        }
    },
    "containers": [
        {
            "name": "krnl_degamma",
            "accelerators": [
                {
                    "name": "degamma_accel",
                    "location": "LIB_DIR/L2/examples/degamma/xf_degamma_accel.cpp",
                    "frequency": 200.0
                }
            ],
            "frequency": 200.0
        }
    ],
    "testinfo": {
        "disable": false,
        "lsf_dynamic": "memory",
        "jobs": [
            {
                "index": 0,
                "dependency": [],
                "env": "",
                "cmd": "",
                "max_memory_MB": {
                    "vitis_hw_build": 16384,
                    "vitis_hw_emu": 8192,
                    "vitis_hw_run": 4096
                },
                "max_time_min": {
                    "vitis_hw_build": 470,
                    "vitis_hw_emu": 470,
                    "vitis_hw_run": 50
                }
            }
        ],
        "targets": [
            "vitis_hw_emu",
            "vitis_hw_build",
            "vitis_hw_run"
        ],
        "category": "full"
    }
}