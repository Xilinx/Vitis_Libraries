{
    "name": "Xilinx blobfromimage YUV422_NPC4 L3 Test",
    "description": [
        "blobfromimage L3 function example"
    ],
    "flow": "system",
    "platform_allowlist": [
        "vck190",
        "vek280",
        "vek385"
    ],
    "platform_blocklist": [],
    "platform_properties": {
        "vck190": {
            "host": {
                "compiler": {
                    "includepaths": [
                        "$(SYSROOT)/usr/include",
                        "$(SYSROOT)/usr/include/opencv4"
                    ]
                },
                "linker": {
                    "librarypaths": [
                        "$(SYSROOT)/usr/lib",
                        "${SYSROOT}/lib"
                    ]
                }
            }
        },
        "vek280": {
            "host": {
                "compiler": {
                    "includepaths": [
                        "$(SYSROOT)/usr/include",
                        "$(SYSROOT)/usr/include/opencv4"
                    ]
                },
                "linker": {
                    "librarypaths": [
                        "$(SYSROOT)/usr/lib",
                        "${SYSROOT}/lib"
                    ]
                }
            }
        },
        "vek385": {
            "host": {
                "compiler": {
                    "includepaths": [
                        "$(SYSROOT)/usr/include",
                        "$(SYSROOT)/usr/include/opencv4"
                    ]
                },
                "linker": {
                    "librarypaths": [
                        "$(SYSROOT)/usr/lib",
                        "${SYSROOT}/lib"
                    ]
                }
            }
        }
    },
    "gui": false,
    "launch": [
        {
            "target": "hw_emu",
            "cmd_args": "LIB_DIR/data/HD.jpg",
            "name": "hw_emu",
            "ld_library_path": [
                "$(OPENCV_LIB)",
                "$(LD_LIBRARY_PATH)",
                "$(XILINX_XRT)/lib"
            ]
        },
        {
            "target": "hw",
            "cmd_args": "LIB_DIR/data/HD.jpg",
            "name": "Hardware",
            "ld_library_path": [
                "$(OPENCV_LIB)",
                "$(LD_LIBRARY_PATH)",
                "$(XILINX_XRT)/lib"
            ]
        }
    ],
    "data": [
        "LIB_DIR/data/4k.jpg",
        "LIB_DIR/data/HD.jpg"
    ],
    "host": {
        "host_exe": "blobfromimage",
        "compiler": {
            "sources": [
                "LIB_DIR/L3/examples/blobfromimage/xf_blobfromimage_tb.cpp",
                "LIB_DIR/ext/xcl2/xcl2.cpp"
            ],
            "includepaths": [
                "LIB_DIR/L3/tests/blobfromimage/YUV422_NPC4",
                "LIB_DIR/L3/examples/blobfromimage"
            ],
            "options": "-O3  -I$(XILINX_HLS)/include -I$(XILINX_HLS)/include -I$(XILINX_HLS)/include",
            "symbols": [
                "__SDSVHLS__"
            ]
        }
    },
    "v++": {
        "compiler": {
            "symbols": [],
            "includepaths": [
                "LIB_DIR/L3/tests/blobfromimage/YUV422_NPC4",
                "LIB_DIR/L3/examples/blobfromimage"
            ],
            "clflags": []
        }
    },
    "containers": [
        {
            "name": "krnl_blobfromimage_yuv422",
            "accelerators": [
                {
                    "name": "blobfromimage_yuv422",
                    "location": "LIB_DIR/L3/examples/blobfromimage/xf_blobfromimage_accel.cpp",
                    "frequency": 300.0
                }
            ],
            "frequency": 300.0
        }
    ],
    "testinfo": {
        "disable": false,
        "lsf_dynamic": "memory",
        "jobs": [
            {
                "index": 0,
                "dependency": [],
                "env": "",
                "cmd": "",
                "max_memory_MB": {
                    "vitis_hw_build": 16384,
                    "vitis_hw_emu": 16384,
                    "vitis_hw_run": 4096
                },
                "max_time_min": {
                    "vitis_hw_build": 470,
                    "vitis_hw_emu": 470,
                    "vitis_hw_run": 50
                }
            }
        ],
        "targets": [
            "vitis_hw_emu",
            "vitis_hw_build",
            "vitis_hw_run"
        ],
        "category": "full"
    }
}
