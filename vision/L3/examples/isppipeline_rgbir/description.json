{
    "name": "Xilinx Isppipeline+rgbir L3 Test",
    "description": [
        "Isppipeline+rgbir L3 function example"
    ],
    "flow": "system",
    "platform_allowlist": [
        "vek280"
    ],
    "platform_blocklist": [],
    "platform_properties": {
        "vek280": {
            "host": {
                "compiler": {
                    "includepaths": [
                        "$(SYSROOT)/usr/include",
                        "$(SYSROOT)/usr/include/opencv4"
                    ]
                },
                "linker": {
                    "librarypaths": [
                        "$(SYSROOT)/usr/lib",
                        "${SYSROOT}/lib"
                    ]
                }
            }
        }
    },
    "gui": false,
    "launch": [
        {
            "target": "hw_emu",
            "cmd_args": " ",
            "name": "hw_emu",
            "ld_library_path": [
                "$(OPENCV_LIB)",
                "$(LD_LIBRARY_PATH)",
                "$(XILINX_XRT)/lib"
            ]
        },
        {
            "target": "hw",
            "cmd_args": " ",
            "name": "hardware_build",
            "ld_library_path": [
                "$(OPENCV_LIB)",
                "$(LD_LIBRARY_PATH)",
                "$(XILINX_XRT)/lib"
            ]
        }
    ],
    "data": [
        ""
    ],
    "host": {
        "host_exe": "isppipeline",
        "compiler": {
            "sources": [
                "LIB_DIR/L3/examples/isppipeline_rgbir/xf_isp_tb.cpp",
                "LIB_DIR/ext/xcl2/xcl2.cpp"
            ],
            "includepaths": [
                "LIB_DIR/L3/examples/isppipeline_rgbir/config"
            ],
            "options": "-O3 -I$(XILINX_HLS)/include -I$(XILINX_HLS)/include -I$(XILINX_HLS)/include"
        }
    },
    "v++": {
        "compiler": {
            "symbols": [],
            "includepaths": [
                "LIB_DIR/L3/examples/isppipeline_rgbir/config"
            ],
            "clflags": []
        }
    },
    "containers": [
        {
            "name": "krnl_ISPPipeline",
            "accelerators": [
                {
                    "name": "ISPPipeline_accel",
                    "location": "LIB_DIR/L3/examples/isppipeline_rgbir/xf_isp_accel.cpp",
                    "frequency": 300.0
                }
            ],
            "frequency": 300.0
        }
    ],
    "testinfo": {
        "disable": true,
        "jobs": [
            {
                "index": 0,
                "dependency": [],
                "env": "",
                "cmd": "",
                "max_memory_MB": {
                    "vitis_hw_build": 40960,
                    "vitis_hw_emu": 28672,
                    "vitis_hw_run": 10240
                },
                "max_time_min": {
                    "vitis_hw_build": 470,
                    "vitis_hw_emu": 470,
                    "vitis_hw_run": 30
                }
            }
        ],
        "targets": [
            "vitis_hw_emu",
            "vitis_hw_build",
            "vitis_hw_run"
        ],
        "category": "full"
    }
}
