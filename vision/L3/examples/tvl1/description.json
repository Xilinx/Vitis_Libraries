{
    "name": "Xilinx Tvl1 L3 Test",
    "description": [
        "Tvl1 L3 function example"
    ],
    "flow": "system",
    "platform_allowlist": [
        "vck190"
    ],
    "platform_blocklist": [],
    "platform_properties": {
        "vck190": {
            "host": {
                "compiler": {
                    "includepaths": [
                        "$(SYSROOT)/usr/include",
                        "$(SYSROOT)/usr/include/opencv4"
                    ]
                },
                "linker": {
                    "librarypaths": [
                        "$(SYSROOT)/usr/lib",
                        "${SYSROOT}/lib"
                    ],
                    "options": "-l opencv_optflow"
                }
            },
            "containers": [
                {
                    "name": "krnl_tvl1",
                    "accelerators": [
                        {
                            "name": "tvl1_accel",
                            "frequency": 150.0
                        },
                        {
                            "name": "img_pyramid_accel",
                            "frequency": 150.0
                        }
                    ],
                    "frequency": 150.0
                }
            ]
        }
    },
    "gui": true,
    "launch": [
        {
            "target": "hw_emu",
            "cmd_args": "LIB_DIR/data/tvl_left.png LIB_DIR/data/tvl_right.png ",
            "name": "hw_emu",
            "ld_library_path": [
                "$(OPENCV_LIB)",
                "$(LD_LIBRARY_PATH)",
                "$(XILINX_XRT)/lib"
            ]
        },
        {
            "target": "hw",
            "cmd_args": "LIB_DIR/data/left.png LIB_DIR/data/right.png ",
            "name": "hardware_build",
            "ld_library_path": [
                "$(OPENCV_LIB)",
                "$(LD_LIBRARY_PATH)",
                "$(XILINX_XRT)/lib"
            ]
        }
    ],
    "data": [
        "LIB_DIR/data/tvl_left.png",
        "LIB_DIR/data/tvl_right.png",
        "LIB_DIR/data/left.png",
        "LIB_DIR/data/right.png"
    ],
    "host": {
        "host_exe": "tvl1",
        "compiler": {
            "sources": [
                "LIB_DIR/L3/examples/tvl1/xf_tvl1_tb.cpp",
                "LIB_DIR/ext/xcl2/xcl2.cpp"
            ],
            "includepaths": [
                "LIB_DIR/L3/examples/tvl1/config"
            ],
            "options": "-O3 -I$(XILINX_HLS)/include -I$(XILINX_HLS)/include -I$(XILINX_HLS)/include",
            "symbols": [
                "__SDSVHLS__"
            ]
        }
    },
    "v++": {
        "compiler": {
            "symbols": [],
            "includepaths": [
                "LIB_DIR/L3/examples/tvl1/config"
            ],
            "clflags": []
        }
    },
    "containers": [
        {
            "name": "krnl_tvl1",
            "accelerators": [
                {
                    "name": "tvl1_accel",
                    "location": "LIB_DIR/L3/examples/tvl1/xf_tvl1_accel.cpp",
                    "frequency": 300.0
                },
                {
                    "name": "img_pyramid_accel",
                    "location": "LIB_DIR/L3/examples/tvl1/xf_img_pyramid_accel.cpp",
                    "frequency": 300.0
                }
            ],
            "frequency": 300.0
        }
    ],
    "testinfo": {
        "disable": false,
        "lsf_dynamic": "memory",
        "jobs": [
            {
                "index": 0,
                "dependency": [],
                "env": "",
                "cmd": "",
                "max_memory_MB": {
                    "vitis_hw_build": 16384,
                    "vitis_hw_emu": 10240,
                    "vitis_hw_run": 4096
                },
                "max_time_min": {
                    "vitis_hw_build": 470,
                    "vitis_hw_emu": 720,
                    "vitis_hw_run": 50
                }
            }
        ],
        "targets": [
            "vitis_hw_emu",
            "vitis_hw_build",
            "vitis_hw_run"
        ],
        "category": "full"
    }
}