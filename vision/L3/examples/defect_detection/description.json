{
    "name": "Xilinx Defect detection L3 Test",
    "description": [
        "Defect detection L3 function example"
    ],
    "flow": "system",
    "platform_allowlist": [
        "vek280"
    ],
    "platform_blocklist": [],
    "platform_properties": {
        "vek280": {
            "host": {
                "compiler": {
                    "includepaths": [
                        "$(SYSROOT)/usr/include",
                        "$(SYSROOT)/usr/include/opencv4"
                    ]
                },
                "linker": {
                    "librarypaths": [
                        "$(SYSROOT)/usr/lib",
                        "${SYSROOT}/lib"
                    ]
                }
            }
        }
    },
    "gui": true,
    "launch": [
        {
            "target": "hw_emu",
            "cmd_args": "LIB_DIR/data/HD2.JPG  ",
            "name": "hw_emu",
            "ld_library_path": [
                "$(OPENCV_LIB)",
                "$(LD_LIBRARY_PATH)",
                "$(XILINX_XRT)/lib"
            ]
        },
        {
            "target": "hw",
            "cmd_args": "LIB_DIR/data/HD2.JPG ",
            "name": "hardware_build",
            "ld_library_path": [
                "$(OPENCV_LIB)",
                "$(LD_LIBRARY_PATH)",
                "$(XILINX_XRT)/lib"
            ]
        }
    ],
    "data": [
        "LIB_DIR/data/HD2.JPG"
    ],
    "host": {
        "host_exe": "threshold",
        "compiler": {
            "sources": [
                "LIB_DIR/L3/examples/defect_detection/xf_threshold_tb.cpp",
                "LIB_DIR/ext/xcl2/xcl2.cpp"
            ],
            "includepaths": [
                "LIB_DIR/L3/examples/defect_detection/config"
            ],
            "options": "-O3"
        }
    },
    "v++": {
        "compiler": {
            "symbols": [],
            "includepaths": [
                "LIB_DIR/L3/examples/defect_detection/config"
            ],
            "clflags": []
        }
    },
    "containers": [
        {
            "name": "krnl_threshold",
            "accelerators": [
                {
                    "name": "gaussian_otsu_accel",
                    "location": "LIB_DIR/L3/examples/defect_detection/xf_gaussian_otsu_accel.cpp",
                    "frequency": 300.0
                },
                {
                    "name": "preprocess_accel",
                    "location": "LIB_DIR/L3/examples/defect_detection/xf_preprocess_accel.cpp",
                    "frequency": 300.0
                },
                {
                    "name": "cca_custom_accel",
                    "location": "LIB_DIR/L3/examples/defect_detection/xf_cca_custom_accel.cpp",
                    "frequency": 300.0
                }
            ],
            "frequency": 300.0
        }
    ],
    "testinfo": {
        "disable": false,
        "lsf_dynamic": "memory",
        "jobs": [
            {
                "index": 0,
                "dependency": [],
                "env": "",
                "cmd": "",
                "max_memory_MB": {
                    "vitis_hw_build": 16384,
                    "vitis_hw_emu": 10240,
                    "vitis_hw_run": 4096
                },
                "max_time_min": {
                    "vitis_hw_build": 470,
                    "vitis_hw_emu": 600,
                    "vitis_hw_run": 50
                }
            }
        ],
        "targets": [
            "vitis_hw_emu",
            "vitis_hw_build",
            "vitis_hw_run"
        ],
        "category": "full"
    }
}